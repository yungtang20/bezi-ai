# Agnes AI server-side configuration. Put real values in .env.local only.
AGNES_API_KEY="REPLACE_WITH_NEW_AGNES_KEY"
BEZI_CHAT_API_KEY="REPLACE_WITH_SERVER_ONLY_CHAT_KEY"
BEZI_AUTH_CLIENT_SECRET="REPLACE_WITH_SERVER_ONLY_AUTH_SECRET"
# Development-only passwordless token issuance. Keep false or unset outside local testing.
ENABLE_DEV_AUTH_BYPASS="false"
# Anonymous session tokens for end users (zero-friction auth). Still protected by per-IP rate limiting.
ENABLE_ANONYMOUS_CHAT="true"
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_MODEL="agnes-3.0-flash"
# Development-only server-side fixture. Keep false or unset outside local smoke tests.
ENABLE_DEV_FIXTURE="false"

# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
