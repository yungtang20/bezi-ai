# NVIDIA_API_KEY: Required for NVIDIA AI API calls (GLM-5.2 model via integrate.api.nvidia.com).
# Users configure this via the Secrets panel in the AI Studio UI or .env.local.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call /api/chat.
# Example: https://your-domain.example,http://localhost:3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
