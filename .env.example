# Agnes AI is called server-side. Never expose these secrets with a VITE_ prefix.
AGNES_API_KEY=""
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_MODEL="agnes-3.0-flash"
BEZI_AUTH_CLIENT_SECRET=""
NODE_ENV="development"

# Comma-separated browser origins allowed to call the API. Production has no
# implicit cross-origin allowlist, so configure every deployed browser origin.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Runtime listener and optional trusted reverse-proxy hop count.
PORT="3000"
TRUST_PROXY_HOPS="0"

# Single-instance request budget. Multi-instance deployments should replace
# the in-memory limiter with a shared adapter before public launch.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="30"

# Frontend-only deployment settings. GitHub Pages uses /bezi-ai/ and points
# browser requests at the separately hosted HTTPS API service.
VITE_BASE_PATH="/"
VITE_API_BASE_URL=""
