# Browser-provided keys (BYOK) remain supported and are preferred. A shared
# NVIDIA_API_KEY is ignored unless ALLOW_SERVER_API_KEY is explicitly true.
NVIDIA_API_KEY=""
ALLOW_SERVER_API_KEY="false"

# Comma-separated browser origins allowed to call the API. Production has no
# implicit cross-origin allowlist, so configure every deployed browser origin.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Runtime listener and optional trusted reverse-proxy hop count.
PORT="3000"
TRUST_PROXY_HOPS="0"
